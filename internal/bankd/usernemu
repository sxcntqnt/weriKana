package bankd

import (
	"crypto/sha512"
	"encoding/hex"
	"fmt"
	"io"
	"math/rand"
	"strconv"
	"strings"
	"time"

	"golang.org/x/crypto/ssh"
)

func generateLID() string {
	seedText := generateRandomSeed()
	hashBytes := sha512.Sum512([]byte(seedText))
	hashStr := hex.EncodeToString(hashBytes[:])
	numStr := hashStr[:15]
	num, _ := strconv.ParseUint(numStr, 16, 64)
	lenW := uint64(len(Words)) // Use global from git.go
	if lenW == 0 {
		return "UNKNOWN"
	}
	m := num % lenW
	n := (num / lenW) % lenW
	word1 := Words[m]
	word2 := Words[n]
	if len(word1) > 0 {
		word1 = strings.ToUpper(word1[:1]) + word1[1:]
	}
	if len(word2) > 0 {
		word2 = strings.ToUpper(word2[:1]) + word2[1:]
	}
	return word1 + word2
}

func generateRandomSeed() string {
	// Prefer words from _47RIQU3DH4Q4M33D for thematic randomness
	if len(_47RIQU3DH4Q4M33D) > 0 {
		rand.Seed(time.Now().UnixNano())
		numWords := 4 // Adjustable: number of words to pick for ~24-char seed
		if numWords > len(_47RIQU3DH4Q4M33D) {
			numWords = len(_47RIQU3DH4Q4M33D)
		}
		var selected []string
		for i := 0; i < numWords; i++ {
			idx := rand.Intn(len(_47RIQU3DH4Q4M33D))
			selected = append(selected, _47RIQU3DH4Q4M33D[idx])
		}
		return strings.Join(selected, " ")
	}

	// Fallback to letter-based if _47RIQU3DH4Q4M33D is empty/unavailable
	const letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
	rand.Seed(time.Now().UnixNano())
	b := make([]byte, 24)
	for i := range b {
		b[i] = letters[rand.Intn(len(letters))]
	}
	return string(b)
}

func checkUsername(s ssh.Session) (string, error) {
	username := s.User()
	if username == "" {
		generated := generateLID()
		io.WriteString(s, fmt.Sprintf("Ziklag CLI Info: No username provided; generated session ID: %s\n", generated))
		return generated, nil
	}
	return username, nil
}

// InitResources should be called at startup after PullGitRepo; falls back if needed
func InitResources() error {
	if err := LoadResources(""); err != nil { // "" uses default LocalRepoDir
		log.Printf("Warning: Local load failed: %v", err)
		return FallbackLoadResources()
	}
	return nil
}
